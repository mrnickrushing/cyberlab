# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/cyberlab
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# --- Optional (defaults shown) ---
PORT=5000
NODE_ENV=development
REDIS_URL=redis://localhost:6379
# pino log level for the API server (trace|debug|info|warn|error)
LOG_LEVEL=info
# When true, the API refuses scans against public addresses (private ranges only)
LAB_ONLY_MODE=true

# --- Worker -> API notifications (worker/worker.py) ---
# Base URL of the API server the worker calls back into, and the shared
# secret both sides use to authenticate those internal notifications.
# API_URL=http://localhost:5000
# INTERNAL_NOTIFY_SECRET=

# --- Push notifications (APNs, artifacts/api-server/src/lib/push.ts) ---
# Leave unset to disable push. Key ID / Team ID from the Apple developer
# account; the private key is the .p8 contents (newlines as \n).
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=

# --- AI assistant (artifacts/api-server/src/routes/ai.ts) ---
# ANTHROPIC_API_KEY=

# --- External API keys (Phase 6, worker/worker.py) ---
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=
# HIBP_API_KEY=
# ABUSEIPDB_API_KEY=
# IPINFO_TOKEN=

# --- Replit / mockup sandbox only ---
# Set automatically on Replit; BASE_PATH is required by artifacts/mockup-sandbox/vite.config.ts
# REPL_ID=
# BASE_PATH=/
